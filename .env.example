# Copy to .env and fill in. .env is gitignored, so real values never reach git.

# Hugging Face token, only needed to upload ingested files (make ingest-trips HF=true).
HF_TOKEN=

# MLflow tracking server and experiment. Python code reads them from .env, but the
# `mlflow run` command reads only the shell, so export them there as well.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=mibici-equipo21
