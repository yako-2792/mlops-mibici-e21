name: mlops-mibici-e21

python_env: python_env.yaml

entry_points:
  ingest:
    command: "python -m mibici_e21.dataset"

  train:
    parameters:
      question: {type: string}
      model: {type: string}
      n_estimators: {type: string, default: ""}
      max_depth: {type: string, default: ""}
      n_clusters: {type: string, default: ""}
      search: {type: string, default: "false"}
    command: >
      python -m mibici_e21.modeling.train
      --question {question}
      --model {model}
      --n_estimators {n_estimators}
      --max_depth {max_depth}
      --n_clusters {n_clusters}
      --search {search}

  register:
    parameters:
      question: {type: string}
      run_id: {type: string, default: ""}
    command: "python -m mibici_e21.modeling.register --question {question} --run_id {run_id}"

  drift:
    command: "python -m mibici_e21.monitoring.drift"

  retrain:
    parameters:
      override_model: {type: string, default: ""}
      override_n_estimators: {type: string, default: ""}
      override_max_depth: {type: string, default: ""}
    command: >
      python -m mibici_e21.monitoring.retrain
      --model {override_model}
      --n_estimators {override_n_estimators}
      --max_depth {override_max_depth}

  ab_test:
    parameters:
      promote: {type: string, default: "false"}
    command: "python -m mibici_e21.monitoring.ab_test --promote {promote}"
